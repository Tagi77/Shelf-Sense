# Server only. Copy to ignored .env.local for local development.
# On Sites, set OPENAI_API_KEY as a secret runtime variable, then deploy.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Gemini is preferred when GEMINI_API_KEY is present. Server secrets only.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_PROVIDER=gemini

# Telegram: server-only. Never prefix secrets with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_INGRESS_SECRET=
SHELF_PUBLIC_URL=https://shelf-sense.a-khassenov28.chatgpt.site
# Required only by an external polling bridge for this private Sites deployment.
# Obtain through supported Sites service access; never commit or print it.
SHELF_SITES_SERVICE_TOKEN=
